<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VoltMatrix Academy | Admission Inquiry Core</title>
    
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">

    <style type="text/css">
        @layer utilities {
            .bg-glassCard {
                background: rgba(15, 23, 42, 0.65);
            }
            .cyber-field {
                background: rgba(30, 41, 59, 0.5);
                border: 2px solid rgba(51, 65, 85, 0.5);
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }
            .cyber-field:focus {
                border-color: #38bdf8;
                box-shadow: 0 0 15px rgba(56, 189, 248, 0.2);
                background: rgba(30, 41, 59, 0.8);
                outline: none;
            }
            .form-label {
                color: #94a3b8;
                font-size: 0.85rem;
                font-weight: 600;
                margin-bottom: 0.5rem;
                letter-spacing: 0.05em;
                text-transform: uppercase;
            }
        }

        /* Border Glow Neon Animation Framework Pulse Effect */
        @keyframes borderAuraPulse {
            0%, 100% { border-color: rgba(99, 102, 241, 0.3); box-shadow: 0 0 20px rgba(99, 102, 241, 0.1); }
            50% { border-color: rgba(6, 182, 212, 0.6); box-shadow: 0 0 35px rgba(6, 182, 212, 0.25); }
        }
    </style>
</head>
<body class="bg-[#0b0f19] text-slate-100 min-h-screen font-sans antialiased selection:bg-indigo-500 selection:text-white">

    <nav class="border-b border-slate-800/60 bg-[#0f172a]/60 backdrop-blur-md fixed top-0 w-full z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <a class="flex items-center gap-2 font-black text-white tracking-wider text-lg" href="/">
                <i class="bi bi-shield-lightning text-sky-400 text-xl"></i>
                <span>VOLTMATRIX<span class="text-sky-400">.EDU</span></span>
            </a>
            <div class="flex items-center gap-4">
                <a href="/" class="text-slate-400 hover:text-white text-sm font-semibold transition-colors">Main Dashboard</a>
                <span class="h-4 w-[1px] bg-slate-800"></span>
                <span class="flex items-center gap-1.5 text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-full border border-emerald-500/20">
                    <span class="h-1.5 w-1.5 rounded-circle bg-emerald-400 animate-pulse"></span> INQUIRY HUB LIVE
                </span>
            </div>
        </div>
    </nav>

    <main class="pt-32 pb-20 px-4">
        <section id="enrollment-inquiry" class="max-w-4xl mx-auto px-6 mb-12">
            <div class="interactive-3d-node rounded-[32px] border-2 bg-glassCard backdrop-blur-3xl p-8 md:p-12 matrix-form-container" style="animation: borderAuraPulse 4s infinite ease-in-out;" data-aos="fade-up" data-aos-duration="1000">
                
                <div class="text-center mb-10">
                    <div class="inline-flex text-4xl bg-gradient-to-r from-sky-400 to-indigo-400 bg-clip-text text-transparent mb-2">
                        <i class="bi bi-envelope-open-fill animate-bounce"></i>
                    </div>
                    <h2 class="text-3xl font-black text-white tracking-tight">Admission Inquiry Hub</h2>
                    <p class="text-slate-400 text-xs max-w-md mx-auto mt-2">Submit communication vectors to establish an operational synchronization channel with the registrar node.</p>
                </div>
                
                <form id="admissionInquiryForm" action="http://localhost:3000/Inquiry/inquiry1" method="POST" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        
                        <div data-aos="fade-right" data-aos-delay="100">
                            <label class="form-label block">Applicant Full Name</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500"><i class="bi bi-person"></i></span>
                                <input type="text" name="CandidateName" class="cyber-field w-full rounded-xl py-3.5 pl-11 pr-4 text-sm text-slate-200" placeholder="Enter full name" required>
                            </div>
                        </div>

                        <div data-aos="fade-left" data-aos-delay="100">
                            <label class="form-label block">Communication Email</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500"><i class="bi bi-envelope-at"></i></span>
                                <input type="email" name="EmailAddress" class="cyber-field w-full rounded-xl py-3.5 pl-11 pr-4 text-sm text-slate-200" placeholder="name@domain.com" required>
                            </div>
                        </div>

                        <div class="md:col-span-2" data-aos="fade-up" data-aos-delay="200">
                            <label class="form-label block">Contact Mobile Array</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500"><i class="bi bi-telephone"></i></span>
                                <input type="text" name="ContactNumber" class="cyber-field w-full rounded-xl py-3.5 pl-11 pr-4 text-sm text-slate-200" placeholder="e.g. 9876543210" required>
                            </div>
                        </div>

                        <div class="md:col-span-2" data-aos="fade-up" data-aos-delay="300">
                            <label class="form-label block">Inquiry Description Stream</label>
                            <textarea name="InquiryMessage" class="cyber-field w-full rounded-xl py-3.5 px-4 text-sm text-slate-200" rows="4" placeholder="Detail your data query packet, required stream choice, or system credentials validation queries..." required></textarea>
                        </div>
                    </div>
                    
                    <div data-aos="zoom-in" data-aos-delay="400">
                        <button type="submit" class="w-full py-4 mt-4 rounded-xl text-sm font-bold uppercase tracking-widest text-white bg-gradient-to-r from-indigo-500 via-purple-500 to-indigo-600 shadow-xl border border-white/10 text-center transition-all duration-300 hover:scale-[1.015] cursor-pointer hover:shadow-[0_15px_30px_rgba(99,102,241,0.4)]">
                            Submit🚀
                        </button>
                    </div>
                </form>

            </div>
        </section>
    </main>

    <footer class="border-t border-slate-900/80 bg-[#070a12] py-6 text-center text-xs text-slate-500 fixed bottom-0 w-full">
        <p>&copy; 2026 VoltMatrix Education Node Setup. All inquiry transmission pipelines secure.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script type="text/javascript">
        AOS.init({
            duration: 800,
            once: true,
            easing: 'ease-out'
        });
    </script>
</body>
</html>