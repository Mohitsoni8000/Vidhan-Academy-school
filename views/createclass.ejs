<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <title>Create Class | Matrix Hub</title>

  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    :root {
      --theme-primary: #6366f1;
      --theme-secondary: #a855f7;
      --theme-glow: rgba(99, 102, 241, 0.15);
    }

    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
    }

    body {
      background: #060913;
      font-family: system-ui, -apple-system, sans-serif;
      overflow-x: hidden;
    }

    /* Premium Fluid Box Translucent Glassmorphism with Fluid Width Engine */
    .form-box {
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(30px);
      -webkit-backdrop-filter: blur(30px);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 24px;
      padding: 2rem;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      width: 100%;
    }

    .form-box:hover {
      box-shadow: 0 0 55px var(--theme-glow);
      border-color: rgba(99, 102, 241, 0.3);
      transform: translateY(-2px);
    }

    .label {
      font-size: 11px;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 1.5px;
      color: #94a3b8;
      margin-bottom: 10px;
    }

    .form-control {
      background: #0b0f19;
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #f1f5f9;
      padding: 16px 18px;
      border-radius: 14px;
      transition: all 0.3s ease;
      font-size: 15px;
    }

    .form-control:focus {
      background: #0b0f19;
      color: #fff;
      border-color: var(--theme-primary);
      box-shadow: 0 0 20px rgba(99, 102, 241, 0.2);
    }

    .input-group-text {
      background: #0b0f19;
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #64748b;
      transition: all 0.3s ease;
    }

    /* Highlight border context on focus */
    .input-group:focus-within .input-group-text {
      border-color: var(--theme-primary);
      color: var(--theme-primary);
    }

    /* ----------------------------------------------------
       🔥 INTERACTIVE ANIMATED ACTION BUTTONS PIPELINES
       ---------------------------------------------------- */
    .btn-create-sync {
      background: linear-gradient(135deg, var(--theme-primary), var(--theme-secondary));
      border: none;
      color: white;
      font-weight: 700;
      font-size: 14px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      padding: 16px 32px;
      border-radius: 14px;
      position: relative;
      overflow: hidden;
      z-index: 1;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 4px 20px rgba(99, 102, 241, 0.3);
      width: auto;
    }

    .btn-create-sync::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(135deg, var(--theme-secondary), var(--theme-primary));
      z-index: -1;
      opacity: 0;
      transition: opacity 0.4s ease;
    }

    .btn-create-sync:hover {
      box-shadow: 0 10px 30px rgba(168, 85, 247, 0.4);
      color: #fff;
    }

    .btn-create-sync:hover::before {
      opacity: 1;
    }

    .btn-create-sync:active {
      transform: scale(0.98);
    }

    /* Media query breakpoints adjustments for absolute sizing grid */
    @media (max-width: 576px) {
      .form-box {
        padding: 1.5rem;
        border-radius: 18px;
      }
      .btn-stack-mobile button {
        width: 100% !important;
      }
    }
  </style>
</head>

<body class="d-flex align-items-center justify-content-center">

  <div id="canvas-container"></div>

  <div class="container-fluid px-3 px-sm-4 px-md-5 py-4 d-flex justify-content-center">
    
    <div class="w-100" style="max-width: 850px;">
      
      <div class="mb-4 px-1">
        <h1 class="fw-black text-white mb-2 tracking-tight d-flex align-items-center gap-2" style="font-weight: 800; font-size: calc(1.6rem + 1vw);">
          <i class="bi bi-door-open text-gradient"></i> Create Class
        </h1>
        <p class="text-secondary small mb-0 fs-6">Initialize and broadcast a brand new class standard asset record directly to database arrays.</p>
      </div>

      <div class="form-box">
        <form action="http://localhost:3000/Class/class1" method="POST">
          <div class="row g-4">
            
            <div class="col-12">
              <div class="label">Class Configuration Name</div>
              <div class="input-group">
                <span class="input-group-text px-3 border-end-0" style="border-radius: 14px 0 0 14px; border-color: rgba(255,255,255,0.08);">
                  <i class="bi bi-door-open fs-5"></i>
                </span>
                <input type="text" name="ClassName" class="form-control border-start-0" style="border-radius: 0 14px 14px 0; border-color: rgba(255,255,255,0.08);" placeholder="Enter complete class standard name (e.g., BCA Sem-IV)" required autocomplete="off">
              </div>
            </div>

          </div>

          <div class="mt-5 d-flex align-items-center justify-content-end btn-stack-mobile">
            
            <button type="submit" class="btn btn-create-sync">
              Create Class <i class="bi bi-arrow-right-short ms-1 fs-5 align-middle"></i>
            </button>

          </div>
        </form>
      </div>

    </div>

  </div>

</body>
</html>