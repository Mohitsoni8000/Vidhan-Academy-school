<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <title>Initialize Section | Matrix Hub</title>

  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    :root {
      --theme-primary: #38bdf8;
      --theme-secondary: #818cf8;
      --theme-glow-rgba: rgba(56, 189, 248, 0.06);
    }

    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
    }

    body {
      background: #020308;
      font-family: system-ui, -apple-system, sans-serif;
      overflow-x: hidden;
    }

    /* Stable Layout Wrapper Context for Vertical Centering */
    .viewport-wrapper {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Premium Fluid Box Translucent Glassmorphism Container */
    .form-box {
      background: rgba(15, 23, 42, 0.55);
      backdrop-filter: blur(35px);
      -webkit-backdrop-filter: blur(35px);
      border: 1px solid rgba(255, 255, 255, 0.04);
      border-radius: 24px;
      padding: 2.5rem;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      width: 100%;
      position: relative;
      z-index: 10;
    }

    .form-box:hover {
      box-shadow: 0 0 55px var(--theme-glow-rgba);
      border-color: rgba(56, 189, 248, 0.25);
      transform: translateY(-2px);
    }

    .label {
      font-size: 11px;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 1.5px;
      color: #64748b;
      margin-bottom: 10px;
    }

    .form-control {
      background: #0b0f19 !important;
      border: 1px solid rgba(255, 255, 255, 0.08) !important;
      color: #f1f5f9 !important;
      padding: 16px 18px;
      border-radius: 14px;
      transition: all 0.3s ease;
      font-size: 15px;
    }

    .form-control:focus {
      border-color: var(--theme-primary) !important;
      box-shadow: 0 0 20px rgba(56, 189, 248, 0.15) !important;
      color: #fff !important;
    }

    .input-group-text {
      background: #0b0f19 !important;
      border: 1px solid rgba(255, 255, 255, 0.08) !important;
      color: #64748b;
      transition: all 0.3s ease;
    }

    .input-group:focus-within .input-group-text {
      border-color: var(--theme-primary) !important;
      color: var(--theme-primary) !important;
    }

    /* Gemini Static Text Gradient Style Matching Dashboard */
    .text-gradient {
      background: linear-gradient(135deg, var(--theme-primary), var(--theme-secondary), #f472b6);
      background-size: 200% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* ----------------------------------------------------
       🔥 INTERACTIVE ANIMATED ACTION BUTTON
       ---------------------------------------------------- */
    .btn-create-sync {
      background: linear-gradient(135deg, var(--theme-primary), var(--theme-secondary));
      border: none;
      color: #020308;
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      padding: 16px 32px;
      border-radius: 14px;
      position: relative;
      overflow: hidden;
      z-index: 1;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 4px 20px rgba(56, 189, 248, 0.25);
    }

    .btn-create-sync::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(135deg, var(--theme-secondary), var(--theme-primary));
      z-index: -1;
      opacity: 0;
      transition: opacity 0.4s ease;
    }

    .btn-create-sync:hover {
      box-shadow: 0 10px 30px rgba(129, 140, 248, 0.35);
      color: #020308;
    }

    .btn-create-sync:hover::before {
      opacity: 1;
    }

    .btn-create-sync:active {
      transform: scale(0.98);
    }

    .btn-cancel-sync {
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: transparent;
      color: #cbd5e1;
      font-weight: 600;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 16px 28px;
      border-radius: 14px;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .btn-cancel-sync:hover {
      background: rgba(255, 255, 255, 0.03);
      border-color: rgba(255, 255, 255, 0.2);
      color: #fff;
    }

    @media (max-width: 576px) {
      .form-box {
        padding: 1.5rem;
        border-radius: 18px;
      }
      .btn-stack-mobile {
        flex-direction: column-reverse;
        gap: 0.75rem !important;
      }
      .btn-stack-mobile a, .btn-stack-mobile button {
        width: 100% !important;
      }
    }
  </style>
</head>

<body>

  <div class="viewport-wrapper container-fluid px-3 px-sm-4 px-md-5 py-4">
    
    <div class="w-100" style="max-width: 850px;">
      
      <div class="mb-4 px-1">
        <h1 class="fw-black text-white mb-2 tracking-tight d-flex align-items-center gap-2" style="font-weight: 800; font-size: calc(1.6rem + 1vw);">
          <i class="bi bi-grid-3x3-gap-fill text-gradient"></i> Create Section
        </h1>
        <p class="text-secondary small mb-0 fs-6">Initialize and broadcast a brand new course section configuration structural row directly to database arrays.</p>
      </div>

      <div class="form-box">
        <form action="http://localhost:3000/Section/section1" method="POST">
          <div class="row g-4">
            
            <div class="col-12">
              <div class="label">Section Identifier Name</div>
              <div class="input-group">
                <span class="input-group-text px-3 border-end-0" style="border-radius: 14px 0 0 14px; border-color: rgba(255,255,255,0.08);">
                  <i class="bi bi-tag fs-5"></i>
                </span>
                <input type="text" name="Name" class="form-control border-start-0" style="border-radius: 0 14px 14px 0; border-color: rgba(255,255,255,0.08);" placeholder="Enter section value name (e.g., A, B, or Sec-1)" required autocomplete="off" maxlength="10">
              </div>
            </div>

          </div>

          <div class="mt-5 d-flex align-items-center justify-content-end gap-3 btn-stack-mobile">
            
            <a href="/sections" class="btn btn-cancel-sync text-decoration-none text-center">
              Cancel
            </a>

            <button type="submit" class="btn btn-create-sync">
              Create Section <i class="bi bi-arrow-right-short ms-1 fs-5 align-middle"></i>
            </button>

          </div>
        </form>
      </div>

    </div>

  </div>

</body>
</html>