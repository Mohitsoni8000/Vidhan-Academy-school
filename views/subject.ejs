<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <title>Subjects | Matrix Hub</title>

  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    body {
      background: #060913;
      font-family: system-ui, -apple-system, sans-serif;
    }

    /* Premium Fluid Box Translucent Glassmorphism Cards */
    .card-box {
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 20px;
      padding: 24px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      height: 100%;
    }

    .card-box:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(99, 102, 241, 0.15);
      border-color: rgba(99, 102, 241, 0.3);
    }

    .avatar {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: linear-gradient(135deg, #6366f1, #a855f7);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: white;
      font-size: 20px;
      flex-shrink: 0;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    }

    .label {
      font-size: 11px;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 1px;
      color: #64748b;
    }

    .value {
      font-weight: 600;
      color: #f1f5f9;
      font-size: 15px;
    }

    .text-gradient {
      background: linear-gradient(135deg, #6366f1, #a855f7);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  </style>
</head>

<body>

<div class="container py-5">

  <div class="mb-5 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <h1 class="fw-extrabold tracking-tight text-white mb-1">
        <i class="bi bi-book-half text-gradient me-2"></i>Subjects Dashboard
      </h1>
      <p class="text-secondary small mb-0">Global index registry of all course subjects assets records</p>
    </div>

    <a href="/subjects/create" class="btn px-4 py-2.5 rounded-3 fw-bold uppercase tracking-wider text-white border-0 shadow-sm" style="background: linear-gradient(135deg, #6366f1, #a855f7); font-size: 13px;">
      <i class="bi bi-plus-lg me-1"></i> Create Subject
    </a>
  </div>

  <div class="row g-4">

    <% if (typeof subjects !== 'undefined' && subjects && subjects.length > 0) { %>

      <% subjects.forEach(function(sub){ %>

      <div class="col-12 col-md-6 col-lg-4">

        <div class="card-box d-flex flex-column justify-content-between">

          <div>
            <div class="d-flex align-items-center gap-3 mb-4">
              <div class="avatar">
                <%= sub?.Name ? sub.Name.charAt(0).toUpperCase() : 'S' %>
              </div>

              <div>
                <h5 class="mb-1 fw-bold text-white leading-snug">
                  <%= sub?.Name || '-' %>
                </h5>
                <span class="badge bg-white-01 border border-white-5 font-mono text-secondary small" style="background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.05); color: #64748b; font-size: 10px;">
                  REF-ID: <%= sub?.SubjectId || '-' %>
                </span>
              </div>
            </div>

            <hr style="border-color: rgba(255,255,255,0.06); margin: 1.25rem 0;">

            <div class="d-flex flex-column gap-2">
              <div class="d-flex flex-column">
                <span class="label mb-1">Subject Name</span>
                <span class="value"><%= sub?.Name || '-' %></span>
              </div>

              <div class="d-flex flex-column mt-2">
                <span class="label mb-1">System Entity ID</span>
                <span class="value font-mono text-info opacity-75">#<%= sub?.SubjectId || '-' %></span>
              </div>
            </div>
          </div>

          </div>

      </div>

      <% }) %>

    <% } else { %>

      <div class="col-12">
        <div class="p-5 text-center rounded-4 border" style="background: rgba(15, 23, 42, 0.4); border-color: rgba(255,255,255,0.05);">
          <div class="display-5 text-muted mb-3">📦</div>
          <h4 class="text-white font-bold mb-1">No Subject Resource Assets Found</h4>
          <p class="text-secondary small mb-0">Initialize the matrix engine by pushing a new course data profile via the creator route button.</p>
        </div>
      </div>

    <% } %>

  </div>

</div>

</body>
</html>