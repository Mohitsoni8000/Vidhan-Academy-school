<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <title>Command Suite | Matrix Management System</title>

  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

  <style>
    :root {
      --theme-bg: #020617;
      --card-bg: rgba(15, 23, 42, 0.45);
      --theme-indigo: #6366f1;
      --theme-purple: #a855f7;
      --theme-cyan: #06b6d4;
      --neon-glow: rgba(99, 102, 241, 0.25);
      --glass-border: rgba(255, 255, 255, 0.05);
    }

    body {
      background-color: var(--theme-bg);
      font-family: system-ui, -apple-system, sans-serif;
      overflow-x: hidden;
      color: #f1f5f9;
      position: relative;
    }

    /* --- HARDWARE-ACCELERATED LIVE ANIMATION ENGINE --- */
    @keyframes nebulaOrbit {
      0% { transform: translate(0px, 0px) scale(1); }
      50% { transform: translate(30px, -15px) scale(1.05); }
      100% { transform: translate(0px, 0px) scale(1); }
    }

    @keyframes statusPulse {
      0%, 100% { opacity: 0.5; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.15); }
    }

    @keyframes liveLaserScan {
      0% { top: -100%; }
      100% { top: 200%; }
    }

    /* Ambient Spatial Mesh Background Vectors */
    body::before {
      content: "";
      position: absolute;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(99, 102, 241, 0.12) 0%, rgba(0,0,0,0) 70%);
      top: -10%;
      right: -10%;
      z-index: 0;
      pointer-events: none;
      animation: nebulaOrbit 12s ease-in-out infinite;
    }

    body::after {
      content: "";
      position: absolute;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(6, 182, 212, 0.08) 0%, rgba(0,0,0,0) 60%);
      bottom: 5%;
      left: -5%;
      z-index: 0;
      pointer-events: none;
      animation: nebulaOrbit 15s ease-in-out infinite alternate;
    }

    .main-viewport {
      position: relative;
      z-index: 10;
    }

    .text-gradient {
      background: linear-gradient(135deg, #38bdf8, var(--theme-indigo) 45%, var(--theme-purple));
      background-size: 200% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Premium Glassmorphic Card Blocks Engine */
    .matrix-card {
      background: var(--card-bg);
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
      border: 1px solid var(--glass-border);
      border-radius: 24px;
      padding: 28px;
      height: 100%;
      position: relative;
      overflow: hidden;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .matrix-card::after {
      content: '';
      position: absolute;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--theme-indigo), transparent);
      top: 0;
      left: -100%;
    }

    .matrix-card:hover::after {
      animation: liveLaserScan 1.5s linear infinite;
    }

    .matrix-card:hover {
      transform: translateY(-8px) scale(1.015);
      border-color: rgba(99, 102, 241, 0.45);
      background: rgba(15, 23, 42, 0.75);
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6), 0 0 40px var(--neon-glow);
    }

    /* Hardware Action Module Icon Wrapper */
    .icon-node {
      width: 54px;
      height: 54px;
      border-radius: 16px;
      background: rgba(99, 102, 241, 0.08);
      border: 1px solid rgba(99, 102, 241, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      color: #a5b4fc;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .matrix-card:hover .icon-node {
      transform: scale(1.12) rotate(8deg);
      background: linear-gradient(135deg, var(--theme-indigo), var(--theme-purple));
      color: #fff;
      box-shadow: 0 0 20px rgba(99, 102, 241, 0.45);
      border-color: transparent;
    }

    /* Relational Properties Row Setup */
    .meta-property {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 7px 0;
      border-bottom: 1px dashed rgba(255, 255, 255, 0.04);
      transition: border-color 0.3s ease;
    }

    .matrix-card:hover .meta-property {
      border-bottom-color: rgba(99, 102, 241, 0.15);
    }

    .meta-property:last-child {
      border-bottom: none;
    }

    .label-title {
      font-size: 11px;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.8px;
      color: #64748b;
      transition: color 0.3s ease;
    }

    .matrix-card:hover .label-title {
      color: #94a3b8;
    }

    .value-tag {
      font-weight: 600;
      color: #cbd5e1;
      font-size: 13px;
      transition: color 0.3s ease;
    }

    .matrix-card:hover .value-tag {
      color: #f8fafc;
    }

    /* System Gateways Interactive Controls Buttons */
    .action-gateways {
      display: flex;
      gap: 12px;
      margin-top: 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding-top: 20px;
    }

    .btn-gateway {
      flex: 1;
      padding: 12px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-create-node {
      background: rgba(99, 102, 241, 0.08);
      border: 1px solid rgba(99, 102, 241, 0.25);
      color: #a5b4fc;
    }

    .btn-create-node:hover {
      background: linear-gradient(135deg, var(--theme-indigo), var(--theme-purple));
      color: #ffffff;
      box-shadow: 0 6px 15px rgba(99, 102, 241, 0.3);
      transform: translateY(-2px);
      border-color: transparent;
    }

    .btn-show-node {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      color: #94a3b8;
    }

    .btn-show-node:hover {
      background: #f1f5f9;
      color: var(--theme-bg);
      box-shadow: 0 6px 15px rgba(255, 255, 255, 0.15);
      transform: translateY(-2px);
      border-color: #f1f5f9;
    }

    /* Custom Sidebar Navigation Container Layer */
    .custom-sidebar {
      background: rgba(9, 15, 32, 0.95) !important;
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
      border-right: 1px solid rgba(99, 102, 241, 0.15) !important;
      width: 290px !important;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 18px;
      color: #94a3b8;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      border-radius: 12px;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sidebar-link:hover {
      background: rgba(99, 102, 241, 0.08);
      color: #fff;
      padding-left: 24px;
    }

    .sidebar-link.active {
      background: linear-gradient(135deg, var(--theme-indigo), var(--theme-purple));
      color: #fff;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.25);
    }

    /* Telemetry Interface Status Display */
    .stat-pill-container {
      background: rgba(15, 23, 42, 0.3);
      border: 1px solid var(--glass-border);
      border-radius: 16px;
      padding: 14px 20px;
      transition: background 0.3s ease;
    }

    .stat-pill-container:hover {
      background: rgba(15, 23, 42, 0.55);
    }

    .status-indicator {
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.2);
      color: #4ade80;
      padding: 6px 16px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      display: inline-flex;
      align-items: center;
    }

    .status-indicator .bi-cpu-fill {
      animation: statusPulse 2s linear infinite;
    }
  </style>
</head>

<body>

  <nav class="navbar navbar-dark py-3 px-3 border-bottom sticky-top" style="background: rgba(2, 6, 23, 0.7); backdrop-filter: blur(15px); border-color: rgba(255,255,255,0.05) !important; z-index: 1000;">
    <div class="container-fluid">
