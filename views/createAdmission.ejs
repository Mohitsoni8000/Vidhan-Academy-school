<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <title>Create Admission | Matrix Hub</title>

  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    body {
      background: #0f172a;
      font-family: system-ui, -apple-system, sans-serif;
    }

    /* Premium Clean Static Solid Glassmorphism Form Container */
    .form-box {
      background: linear-gradient(145deg, #1e293b, #0f172a);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    .label {
      font-size: 11px;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 1px;
      color: #94a3b8;
      margin-bottom: 8px;
    }

    .form-control {
      background: #0f172a !important;
      border: 1px solid rgba(255, 255, 255, 0.1) !important;
      color: #e2e8f0 !important;
      padding: 14px 16px;
      border-radius: 12px;
      transition: all 0.3s ease;
      font-size: 14px;
    }

    .form-control:focus {
      border-color: #6366f1 !important;
      box-shadow: 0 0 15px rgba(99, 102, 241, 0.15) !important;
      color: #fff !important;
    }

    /* Primary Accent Linear Styling Components */
    .text-gradient {
      background: linear-gradient(135deg, #6366f1, #a855f7);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .btn-submit-sync {
      background: linear-gradient(135deg, #6366f1, #a855f7);
      border: none;
      color: #ffffff;
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      padding: 14px 30px;
      border-radius: 12px;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.2);
    }

    .btn-submit-sync:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(168, 85, 247, 0.3);
      color: #ffffff;
    }

    .btn-cancel-sync {
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: transparent;
      color: #94a3b8;
      font-weight: 600;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 14px 24px;
      border-radius: 12px;
      transition: all 0.3s ease;
    }

    .btn-cancel-sync:hover {
      background: rgba(255, 255, 255, 0.03);
      border-color: rgba(255, 255, 255, 0.2);
      color: #fff;
    }

    @media (max-width: 576px) {
      .form-box {
        padding: 1.5rem;
      }
      .btn-stack-mobile {
        flex-direction: column-reverse;
        gap: 0.75rem !important;
      }
      .btn-stack-mobile a, .btn-stack-mobile button {
        width: 100% !important;
      }
    }
  </style>
</head>

<body>

<div class="container py-5">

  <div class="mb-4 px-1">
    <h1 class="fw-bold text-white mb-2 tracking-tight">
      <i class="bi bi-mortarboard-fill text-gradient me-2"></i>Create Admission
    </h1>
    <p class="text-secondary small mb-0 fs-6">Initialize and map a brand new student profile entity row to database indices.</p>
  </div>

  <div class="form-box">

    <form action="http://localhost:3000/Admission/admission1" method="POST">

      <div class="row g-4">

        <div class="col-md-6">
          <div class="label"><i class="bi bi-person me-1 text-gradient"></i> First Name</div>
          <input type="text" name="Name" class="form-control" required autocomplete="off" placeholder="Enter given first name">
        </div>

        <div class="col-md-6">
          <div class="label"><i class="bi bi-person-vcard me-1 text-gradient"></i> Surname</div>
          <input type="text" name="SurName" class="form-control" autocomplete="off" placeholder="Enter family last name">
        </div>

        <div class="col-md-6">
          <div class="label"><i class="bi bi-person-fill-check me-1 text-gradient"></i> Father Name</div>
          <input type="text" name="FatherName" class="form-control" autocomplete="off" placeholder="Enter complete father profile name">
        </div>

        <div class="col-md-6">
          <div class="label"><i class="bi bi-person-fill-lock me-1 text-gradient"></i> Mother Name</div>
          <input type="text" name="MotherName" class="form-control" autocomplete="off" placeholder="Enter complete mother profile name">
        </div>

        <div class="col-md-4">
          <div class="label"><i class="bi bi-bookmark-fill me-1 text-gradient"></i> Class Reference</div>
          <input type="text" name="ClassId" class="form-control" autocomplete="off" placeholder="e.g., BCA Sem-V">
        </div>

        <div class="col-md-4">
          <div class="label"><i class="bi bi-grid-3x3-gap-fill me-1 text-gradient"></i> Section Track</div>
          <input type="text" name="SectionId" class="form-control" autocomplete="off" placeholder="e.g., Sec-A">
        </div>

        <div class="col-md-4">
          <div class="label"><i class="bi bi-gender-ambiguous me-1 text-gradient"></i> Gender</div>
          <input type="text" name="Gender" class="form-control" autocomplete="off" placeholder="Male / Female / Other">
        </div>

        <div class="col-md-6">
          <div class="label"><i class="bi bi-globe-americas me-1 text-gradient"></i> Religion</div>
          <input type="text" name="Religion" class="form-control" autocomplete="off" placeholder="e.g., Hindu">
        </div>

        <div class="col-md-6">
          <div class="label"><i class="bi bi-diagram-3-fill me-1 text-gradient"></i> Caste Category</div>
          <input type="text" name="Caste" class="form-control" autocomplete="off" placeholder="e.g., General / OBC / SC / ST">
        </div>

        <div class="col-12">
          <div class="label"><i class="bi bi-tags-fill me-1 text-gradient"></i> Sub Caste</div>
          <input type="text" name="SubCaste" class="form-control" autocomplete="off" placeholder="Enter detailed sub-caste identification tag">
        </div>

      </div>

      <div class="mt-5 d-flex align-items-center justify-content-end gap-3 btn-stack-mobile">
        
        <a href="/admissions" class="btn btn-cancel-sync text-decoration-none text-center">
          Cancel
        </a>

        <button type="submit" class="btn btn-submit-sync">
          Save Admission <i class="bi bi-arrow-right-short ms-1 fs-5 align-middle"></i>
        </button>

      </div>

    </form>

  </div>

</div>

</body>
</html>