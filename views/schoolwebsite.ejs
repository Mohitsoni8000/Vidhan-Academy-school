  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script>
    // ==========================================================================
    // 1. INITIAL PRELOADER PROGRESS ENGINE
    // ==========================================================================
    (function () {
      const preloader = document.getElementById('vidhan-preloader');
      const barFill = document.getElementById('preloaderBarFill');
      const percentTxt = document.getElementById('preloaderPercent');
      const subTxt = document.getElementById('preloader-subtext');
      let progress = 0;

      const timer = setInterval(() => {
        progress += Math.floor(Math.random() * 14) + 6;
        if (progress >= 100) {
          progress = 100;
          clearInterval(timer);
          if (subTxt) subTxt.textContent = "All Vidhan Academy Nodes Verified. Launching...";
          setTimeout(() => {
            if (preloader) preloader.classList.add('preloader-hidden');
            if (window.AOS) AOS.refresh();
          }, 420);
        }
        if (barFill) barFill.style.width = progress + '%';
        if (percentTxt) percentTxt.textContent = progress + '%';
      }, 95);
    })();

    AOS.init({ once: true, duration: 800, easing: 'ease-out-cubic' });

    // Marquee infinite loop duplicate
    const track = document.getElementById('marqueeTrack');
    if (track) track.innerHTML += track.innerHTML;

    // Typewriter Engine
    const textTarget = document.getElementById("dynamic-type-text");
    const captionsArray = ["Vidhan Academy School Hub", "Sequelize Object Field Maps Ready", "Unified Institutional ERP Console"];
    let arrayIndex = 0, charIndex = 0, isDeleting = false, typingSpeed = 100;
    function executeTypingPipeline() {
      const full = captionsArray[arrayIndex];
      if (isDeleting) { textTarget.textContent = full.substring(0, charIndex - 1); charIndex--; typingSpeed = 40; }
      else { textTarget.textContent = full.substring(0, charIndex + 1); charIndex++; typingSpeed = 100; }
      if (!isDeleting && charIndex === full.length) { typingSpeed = 2000; isDeleting = true; }
      else if (isDeleting && charIndex === 0) { isDeleting = false; arrayIndex = (arrayIndex + 1) % captionsArray.length; typingSpeed = 500; }
      setTimeout(executeTypingPipeline, typingSpeed);
    }
    document.addEventListener("DOMContentLoaded", () => setTimeout(executeTypingPipeline, 1400));

    // Robot Head Mouse Tracking
    const botHead = document.getElementById("bot-mesh-head");
    const botHook = document.getElementById("interactive-bot-hook");
    if (botHead && botHook) {
      document.addEventListener("mousemove", (e) => {
        const b = botHook.getBoundingClientRect();
        const dx = e.clientX - (b.left + b.width / 2), dy = e.clientY - (b.top + b.height / 2);
        botHead.style.transform = `rotateX(${Math.max(-15, Math.min(15, -dy / 20))}deg) rotateY(${Math.max(-20, Math.min(20, dx / 20))}deg)`;
      });
    }

    // Glass Card Mouse Spotlight + 3D Tilt
    document.querySelectorAll('.glass-box').forEach(card => {
      card.addEventListener('mousemove', e => {
        const r = card.getBoundingClientRect();
        const x = e.clientX - r.left, y = e.clientY - r.top;
        card.style.setProperty('--mx', x + 'px'); card.style.setProperty('--my', y + 'px');
        if (card.classList.contains('tilt') && window.innerWidth > 992) {
          const rx = ((y / r.height) - .5) * -6, ry = ((x / r.width) - .5) * 6;
          card.style.transform = `translateY(-8px) perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg)`;
        }
      });
      card.addEventListener('mouseleave', () => { card.style.transform = ''; });
    });

    // Numerical Counters
    const counterObs = new IntersectionObserver((entries) => {
      entries.forEach(en => {
        if (!en.isIntersecting) return;
        const el = en.target, target = +el.dataset.target, dur = 1600, start = performance.now();
        (function tick(now) {
          const p = Math.min((now - start) / dur, 1);
          el.textContent = Math.floor((1 - Math.pow(1 - p, 3)) * target);
          if (p < 1) requestAnimationFrame(tick);
        })(start);
        counterObs.unobserve(el);
      });
    }, { threshold: .5 });
    document.querySelectorAll('.counter').forEach(c => counterObs.observe(c));

    // Scroll Progress & ToTop Button
    const prog = document.getElementById('scroll-progress'), toTop = document.getElementById('toTop');
    const navLinks = document.querySelectorAll('.navbar .nav-link');
    const secs = ['hero', 'campus-gallery', 'schema-modules', 'portals', 'reviews', 'inquiry', 'metrics'].map(id => document.getElementById(id));
    window.addEventListener('scroll', () => {
      const h = document.documentElement;
      prog.style.width = (h.scrollTop / (h.scrollHeight - h.clientHeight) * 100) + '%';
      toTop.classList.toggle('show', h.scrollTop > 500);
      let current = secs[0]?.id;
      secs.forEach(s => { if (s && s.getBoundingClientRect().top < 140) current = s.id; });
      navLinks.forEach(l => l.classList.toggle('active', l.getAttribute('href') === '#' + current));
    }, { passive: true });
    toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

    navLinks.forEach(l => l.addEventListener('click', () => {
      const nav = document.getElementById('matrixNav');
      if (nav && nav.classList.contains('show')) bootstrap.Collapse.getOrCreateInstance(nav).hide();
    }));

    // Particles Engine
    (function () {
      const c = document.getElementById('particles'), ctx = c.getContext('2d');
      let w, h, pts = [];
      const resize = () => { w = c.width = innerWidth; h = c.height = innerHeight; };
      resize(); addEventListener('resize', resize);
      const count = innerWidth < 768 ? 25 : 55;
      for (let i = 0; i < count; i++) pts.push({ x: Math.random() * w, y: Math.random() * h, vx: (Math.random() - .5) * .3, vy: (Math.random() - .5) * .3, r: Math.random() * 1.5 + .5 });
      (function draw() {
        ctx.clearRect(0, 0, w, h);
        pts.forEach((p, i) => {
          p.x += p.vx; p.y += p.vy;
          if (p.x < 0 || p.x > w) p.vx *= -1; if (p.y < 0 || p.y > h) p.vy *= -1;
          ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 6.283); ctx.fillStyle = 'rgba(6,182,212,.55)'; ctx.fill();
          for (let j = i + 1; j < pts.length; j++) {
            const q = pts[j], d = Math.hypot(p.x - q.x, p.y - q.y);
            if (d < 120) { ctx.strokeStyle = `rgba(99,102,241,${.12 * (1 - d / 120)})`; ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y); ctx.stroke(); }
          }
        });
        requestAnimationFrame(draw);
      })();
    })();

    // Textarea Character Counter
    const msg = document.getElementById('inquiryMsg'), cnt = document.getElementById('msgCount');
    if (msg && cnt) msg.addEventListener('input', () => cnt.textContent = msg.value.length);

    // Cyber Boot Sequence & Voice Greeting
    function triggerCyberBootSequence() {
      const bars = document.querySelectorAll("#bot-mouth-matrix .mouth-bar");
      const mouthInterval = setInterval(() => {
        bars.forEach(b => { b.style.height = `${Math.floor(Math.random() * 12) + 3}px`; b.style.backgroundColor = "var(--cyan-accent)"; });
      }, 70);

      if ('speechSynthesis' in window) {
        const u = new SpeechSynthesisUtterance("Welcome, Operator Mohit Soni. Vidhan Academy ERP access initialized. Compiling system telemetry arrays now.");
        u.rate = 0.95; window.speechSynthesis.speak(u);
      }

      setTimeout(() => {
        clearInterval(mouthInterval);
        document.getElementById("app-sections").style.display = "none";
        document.querySelector(".custom-navbar").style.display = "none";
        document.getElementById("toTop").style.display = "none";
        document.getElementById("ai-loader-screen").style.display = "flex";
        executeTerminalLoggingPipeline();
      }, 1200);
    }

    function executeTerminalLoggingPipeline() {
      const feed = document.getElementById("terminal-feed"), statusText = document.getElementById("boot-status"), bar = document.getElementById("boot-bar");
      const logs = [
        "🛡️ [VIDHAN_CORE]: Initiating Vidhan Academy school databases...",
        "🎛️ [ROUTING]: Compiling customized field variable vectors...",
        "⚙️ [SEQUELIZE]: Mappings loaded for admissions & faculty keys...",
        "🔐 [IDENTITY]: Flagged verified developer: MOHIT SONI [ROOT]",
        "🚀 [REDIRECT]: Launching professional school control dashboard..."
      ];
      logs.forEach((m, i) => {
        setTimeout(() => {
          const d = document.createElement("div"); d.className = "log-line";
          d.innerHTML = `<i class="bi bi-chevron-right text-cyan"></i> ${m}`;
          feed.appendChild(d);
          bar.style.width = ((i + 1) / logs.length * 100) + '%';
          if (i === 2) statusText.textContent = "SYNCHRONIZING ENTERPRISE SYSTEM PORTS";
          if (i === 4) { statusText.innerHTML = "ADMIN ACCESS GRANTED <i class='bi bi-shield-check text-success ms-1'></i>"; statusText.style.color = "#34d399"; }
        }, i * 800);
      });
      setTimeout(() => { window.location.href = "/dash"; }, logs.length * 850);
    }

    // Inquiry Form AJAX Submission Handler
    document.getElementById('dashboardInquiryForm').addEventListener('submit', async function (e) {
      e.preventDefault();
      const submitBtn = this.querySelector('button[type="submit"]');
      const originalLabel = submitBtn.innerHTML;
      const alertBox = document.getElementById('inquiryAlertBox');
      const body = new URLSearchParams(new FormData(this));

      try {
        submitBtn.innerHTML = 'Transmitting Vector Packet... <span class="spinner-border spinner-border-sm ms-2"></span>';
        submitBtn.disabled = true;
        alertBox.className = 'd-none';

        const response = await fetch('/Inquiry/inquiry1', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
          body: body.toString()
        });
        const result = await response.json();

        if (result.success) {
          const dbData = result.data || {};
          alertBox.className = 'alert alert-success bg-success bg-opacity-10 text-success border border-success border-opacity-25 font-mono small p-3 mb-4 rounded-xl d-block';
          alertBox.innerHTML = `
            <div class="fw-bold mb-1"><i class="bi bi-shield-check-fill me-2"></i> Inquiry Transmitted to Vidhan Academy Successfully!</div>
            <p class="mb-2 text-light small">Thank you for your inquiry! Our admissions team will be contacting you within 24 hours.</p>
            <hr class="border-success opacity-25 my-2">
            <div class="text-muted" style="font-size: 11px;">
              <span><strong>Reference ID:</strong> #${dbData.InquiryId || '2'}</span> | 
              <span class="text-cyan"><strong>Inquiry No:</strong> ${dbData.InquiryNumber || 'INQ-2026-WMYN'}</span>
            </div>
          `;
          this.reset(); cnt.textContent = '0';
        } else {
          alertBox.className = 'alert alert-danger bg-danger bg-opacity-10 text-danger border-0 font-mono small py-3 mb-4 rounded-3 d-block';
          alertBox.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-2"></i> ${result.error || 'Validation failure across routing conduits.'}`;
        }
      } catch (err) {
        console.error("Transmission Interface Error:", err);
        alertBox.className = 'alert alert-danger bg-danger bg-opacity-10 text-danger border-0 font-mono small py-3 mb-4 rounded-3 d-block';
        alertBox.innerHTML = `<i class="bi bi-wifi-off me-2"></i> Failed to communicate with core API endpoints. Check connection.`;
      } finally {
        submitBtn.innerHTML = originalLabel;
        submitBtn.disabled = false;
      }
    });
  </script>
</body>
</html>