<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <title>Vidhan Academy School | Next-Gen Institutional ERP</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">

  <!-- Bootstrap 5.3 + Icons + AOS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

  <!-- Tailwind CSS (Prefixed "tw-" and preflight disabled to prevent conflicts) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      prefix: 'tw-',
      corePlugins: { preflight: false },
      theme: {
        extend: {
          colors: {
            primaryIndigo: '#6366f1',
            accentCyan: '#06b6d4',
            vibePurple: '#7c3aed',
            neonPink: '#ec4899',
            goldWarm: '#f59e0b'
          }
        }
      }
    };
  </script>

  <style>
    :root {
      --bg-dark: #030712;
      --card-bg: rgba(15, 23, 42, 0.62);
      --indigo-primary: #6366f1;
      --cyan-accent: #06b6d4;
      --purple-accent: #7c3aed;
      --pink-accent: #ec4899;
      --gold-accent: #f59e0b;
      --glass-border: rgba(255, 255, 255, 0.09);
      --neon-glow: rgba(99, 102, 241, 0.38);
    }

    html { scroll-behavior: smooth; }
    body {
      background-color: var(--bg-dark);
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      color: #f1f5f9;
      overflow-x: hidden;
    }
    h1, h2, h3, h4, .font-display { font-family: 'Space Grotesk', sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
    .text-cyan { color: var(--cyan-accent); }
    .label-title { color: #94a3b8; letter-spacing: .6px; text-transform: uppercase; }

    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #02050e; }
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, var(--cyan-accent), var(--indigo-primary), var(--pink-accent));
      border-radius: 8px;
    }

    /* ==========================================================================
       1. INITIAL PAGE PRELOADER (WITH SCHOOL CREST & CAMPUS PHOTO)
       ========================================================================== */
    #vidhan-preloader {
      position: fixed;
      inset: 0;
      z-index: 999999;
      background: radial-gradient(circle at 50% 35%, #0f172a 0%, #030712 70%, #010309 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.85s ease, transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    }
    #vidhan-preloader.preloader-hidden {
      opacity: 0;
      visibility: hidden;
      transform: scale(1.06);
      pointer-events: none;
    }

    .preloader-crest-wrapper {
      position: relative;
      width: 155px;
      height: 155px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 28px;
    }
    .preloader-orbit-1 {
      position: absolute;
      inset: -14px;
      border-radius: 50%;
      border: 2px dashed rgba(6, 182, 212, 0.55);
      animation: spin 10s linear infinite;
    }
    .preloader-orbit-2 {
      position: absolute;
      inset: -26px;
      border-radius: 50%;
      border: 1.5px solid transparent;
      border-top-color: var(--indigo-primary);
      border-bottom-color: var(--pink-accent);
      animation: spin 3.2s linear infinite reverse;
      box-shadow: 0 0 35px rgba(99, 102, 241, 0.35);
    }
    .preloader-orbit-3 {
      position: absolute;
      inset: -6px;
      border-radius: 50%;
      background: conic-gradient(from 0deg, transparent, rgba(6, 182, 212, 0.4), var(--indigo-primary), transparent);
      animation: spin 2.2s linear infinite;
      filter: blur(6px);
    }

    .preloader-school-photo {
      width: 132px;
      height: 132px;
      border-radius: 50%;
      object-fit: cover;
      position: relative;
      z-index: 2;
      border: 3px solid rgba(255, 255, 255, 0.85);
      box-shadow: 0 0 40px rgba(6, 182, 212, 0.5), inset 0 0 20px rgba(0, 0, 0, 0.6);
      animation: pulsePhoto 2.5s ease-in-out infinite;
    }
    @keyframes pulsePhoto {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.04); }
    }

    .preloader-badge-float {
      position: absolute;
      bottom: -6px;
      right: -6px;
      z-index: 5;
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--indigo-primary), var(--cyan-accent));
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      border: 2px solid #030712;
      box-shadow: 0 6px 20px rgba(6, 182, 212, 0.6);
    }

    .preloader-bar-track {
      width: min(320px, 82vw);
      height: 7px;
      background: rgba(255, 255, 255, 0.07);
      border-radius: 999px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
      margin-top: 14px;
    }
    .preloader-bar-fill {
      height: 100%;
      width: 0%;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--cyan-accent), var(--indigo-primary), var(--pink-accent), var(--gold-accent));
      box-shadow: 0 0 18px var(--cyan-accent);
      transition: width 0.12s ease-out;
    }

    /* ---------- Animated Nebula Orbs & Grid ---------- */
    .bg-orbs { position: fixed; inset: 0; z-index: -2; overflow: hidden; pointer-events: none; }
    .orb { position: absolute; border-radius: 50%; filter: blur(120px); opacity: .3; animation: floatOrb 20s ease-in-out infinite; }
    .orb.o1 { width: 520px; height: 520px; background: var(--indigo-primary); top: -100px; left: -100px; }
    .orb.o2 { width: 480px; height: 480px; background: var(--cyan-accent); top: 30%; right: -120px; animation-delay: -5s; opacity: .2; }
    .orb.o3 { width: 500px; height: 500px; background: var(--pink-accent); bottom: -140px; left: 20%; animation-delay: -10s; opacity: .15; }
    @keyframes floatOrb { 0%,100% { transform: translate(0,0) scale(1);} 33% { transform: translate(50px,-50px) scale(1.1); } 66% { transform: translate(-30px,40px) scale(.95); } }
    
    .bg-grid {
      position: fixed; inset: 0; z-index: -1; pointer-events: none;
      background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
      background-size: 50px 50px;
      mask-image: radial-gradient(ellipse at center, #000 40%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse at center, #000 40%, transparent 80%);
    }
    #particles { position: fixed; inset: 0; z-index: -1; pointer-events: none; }

    /* ---------- Scroll Laser Progress Bar ---------- */
    #scroll-progress { position: fixed; top: 0; left: 0; height: 3.5px; width: 0; z-index: 2000; background: linear-gradient(90deg, var(--cyan-accent), var(--indigo-primary), var(--pink-accent), var(--gold-accent)); box-shadow: 0 0 16px var(--cyan-accent); }

    /* ---------- Master Gradient Text ---------- */
    .text-gradient-master {
      background: linear-gradient(135deg, #38bdf8, var(--indigo-primary) 35%, #a855f7 70%, var(--pink-accent));
      background-size: 240% auto;
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: gradShift 6s linear infinite;
    }
    @keyframes gradShift { to { background-position: 240% center; } }

    /* ---------- Glass Boxes with Mouse Spotlight ---------- */
    .glass-box {
      position: relative;
      background: var(--card-bg);
      backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px);
      border: 1px solid var(--glass-border);
      border-radius: 24px;
      transition: transform .4s cubic-bezier(.16,1,.3,1), border-color .4s, box-shadow .4s;
      overflow: hidden;
    }
    .glass-box::before {
      content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .35s;
      background: radial-gradient(400px circle at var(--mx, 50%) var(--my, 50%), rgba(99,102,241,.25), transparent 50%);
    }
    .glass-box:hover::before { opacity: 1; }
    .glass-box:hover {
      transform: translateY(-8px);
      border-color: rgba(99,102,241,.5);
      box-shadow: 0 25px 50px rgba(0,0,0,.6), 0 0 35px var(--neon-glow);
    }
    .glass-box > * { position: relative; z-index: 1; }

    /* Gradient Border Card Wrapper */
    .grad-border { position: relative; border-radius: 26px; padding: 1.5px; background: linear-gradient(135deg, rgba(6,182,212,.7), rgba(99,102,241,.3) 40%, rgba(236,72,153,.6)); box-shadow: 0 15px 35px rgba(0,0,0,.4); }
    .grad-border > .inner { border-radius: 25px; background: rgba(3,7,18,.92); height: 100%; }

    /* ---------- Navbar ---------- */
    .custom-navbar { background: rgba(3,7,18,.78) !important; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-bottom: 1px solid var(--glass-border); }
    .nav-school-logo {
      width: 40px; height: 40px; border-radius: 12px; object-fit: cover;
      border: 1.5px solid var(--cyan-accent);
      box-shadow: 0 0 15px rgba(6,182,212,.35);
    }
    .navbar .nav-link { position: relative; color: #cbd5e1; transition: color .3s; font-weight: 500; }
    .navbar .nav-link::after { content:""; position:absolute; left:50%; bottom:4px; width:0; height:2px; background: linear-gradient(90deg,var(--cyan-accent),var(--indigo-primary)); transition: all .35s; transform: translateX(-50%); border-radius: 2px; }
    .navbar .nav-link:hover, .navbar .nav-link.active { color: #fff; }
    .navbar .nav-link:hover::after, .navbar .nav-link.active::after { width: 75%; }

    /* ---------- Typewriter Engine ---------- */
    .typewriter-container { display: inline-flex; min-height: 1.2em; max-width: 100%; }
    #dynamic-type-text { border-right: 3px solid var(--cyan-accent); white-space: normal; padding-right: 4px; letter-spacing: -.5px; animation: blinkCursor .75s step-end infinite, gradShift 6s linear infinite; }
    @keyframes blinkCursor { from,to { border-color: transparent; } 50% { border-color: var(--cyan-accent); } }

    /* ---------- Interactive Robot & School Crest Showcase ---------- */
    .robot-wrap { position: relative; display: inline-block; }
    .robot-container { width: 130px; height: 130px; position: relative; perspective: 1000px; animation: botFloat 4.5s ease-in-out infinite; }
    @keyframes botFloat { 0%,100% { transform: translateY(0);} 50% { transform: translateY(-14px);} }
    .robot-head { width: 100%; height: 100%; background: linear-gradient(145deg,#1e293b,#0f172a); border: 2.5px solid var(--indigo-primary); border-radius: 30px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; transition: transform .15s ease-out; box-shadow: 0 0 45px rgba(99,102,241,.5), inset 0 0 22px rgba(6,182,212,.15); position: relative; }
    .robot-head::before, .robot-head::after { content:""; position:absolute; top:-16px; width:4px; height:16px; background: var(--indigo-primary); border-radius: 4px; }
    .robot-head::before { left: 32px; } .robot-head::after { right: 32px; }
    .robot-visor { width: 72%; height: 18px; background: #000; border-radius: 12px; position: relative; overflow: hidden; border: 1px solid rgba(6,182,212,.3); }
    .visor-laser { position: absolute; top: 0; left: -30%; width: 35%; height: 100%; background: linear-gradient(90deg,transparent,var(--cyan-accent),transparent); animation: visorScan 2.2s linear infinite; }
    @keyframes visorScan { 0% { left: -30%; } 100% { left: 110%; } }
    .robot-mouth { display: flex; gap: 4px; align-items: center; height: 14px; }
    .mouth-bar { width: 4px; height: 5px; background: var(--cyan-accent); border-radius: 50%; transition: height .07s; }
    
    .ring { position: absolute; inset: -26px; border-radius: 50%; border: 1px dashed rgba(99,102,241,.45); animation: spin 16s linear infinite; pointer-events: none; }
    .ring.r2 { inset: -52px; border-color: rgba(6,182,212,.3); animation-duration: 24s; animation-direction: reverse; }
    @keyframes spin { to { transform: rotate(360deg); } }
    
    .float-chip { position: absolute; padding: 7px 14px; border-radius: 14px; font-size: 12px; background: rgba(15,23,42,.88); border: 1px solid var(--glass-border); backdrop-filter: blur(12px); white-space: nowrap; animation: chipFloat 5.5s ease-in-out infinite; box-shadow: 0 8px 20px rgba(0,0,0,.45); }
    .float-chip.c1 { top: -35px; left: -105px; } .float-chip.c2 { bottom: -5px; right: -115px; animation-delay: -2.2s; } .float-chip.c3 { bottom: -55px; left: -80px; animation-delay: -3.8s; }
    @keyframes chipFloat { 0%,100% { transform: translateY(0);} 50% { transform: translateY(-10px);} }

    /* Campus Photo Gallery Cards */
    .campus-photo-card {
      position: relative;
      border-radius: 22px;
      overflow: hidden;
      height: 230px;
      border: 1px solid var(--glass-border);
      box-shadow: 0 15px 35px rgba(0,0,0,0.45);
    }
    .campus-photo-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s ease;
    }
    .campus-photo-card:hover img {
      transform: scale(1.1);
      filter: brightness(1.1);
    }
    .campus-photo-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(3,7,18,0.1) 20%, rgba(3,7,18,0.92) 100%);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 20px;
    }

    /* ---------- Glow Buttons ---------- */
    .btn-portal-launch {
      position: relative; overflow: hidden;
      background: linear-gradient(135deg, var(--indigo-primary), var(--purple-accent), var(--pink-accent));
      background-size: 200% 200%;
      border: 1px solid rgba(255,255,255,.15); color: #fff;
      padding: 15px 38px; border-radius: 16px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
      display: inline-flex; align-items: center; gap: 10px; text-decoration: none; cursor: pointer;
      transition: transform .4s cubic-bezier(.16,1,.3,1), box-shadow .4s, background-position .6s;
    }
    .btn-portal-launch::after { content:""; position:absolute; top:0; left:-120%; width:60%; height:100%; background: linear-gradient(90deg,transparent,rgba(255,255,255,.4),transparent); transform: skewX(-20deg); transition: left .7s; }
    .btn-portal-launch:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 16px 36px rgba(99,102,241,.55); color: #fff; background-position: 100% 50%; }
    .btn-portal-launch:hover::after { left: 140%; }
    
    .btn-ghost { border: 1px solid rgba(255,255,255,.18); color: #e2e8f0; background: rgba(255,255,255,.03); padding: 15px 30px; border-radius: 16px; font-weight: 600; text-decoration: none; transition: all .35s; display: inline-flex; align-items: center; gap: 8px; }
    .btn-ghost:hover { background: rgba(255,255,255,.08); border-color: var(--cyan-accent); color: #fff; transform: translateY(-3px); box-shadow: 0 10px 25px rgba(6,182,212,.25); }

    /* ---------- Module Cards & Badges ---------- */
    .icon-node-feature { width: 58px; height: 58px; border-radius: 18px; background: linear-gradient(135deg, rgba(99,102,241,.25), rgba(6,182,212,.2)); color: var(--cyan-accent); display: flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 18px; transition: transform .5s cubic-bezier(.16,1,.3,1), background .4s, color .4s; }
    .glass-box:hover .icon-node-feature { transform: rotate(-8deg) scale(1.15); background: linear-gradient(135deg, var(--indigo-primary), var(--cyan-accent)); color: #fff; box-shadow: 0 0 20px var(--cyan-accent); }
    
    .field-log-badge { background: rgba(255,255,255,.035); border: 1px solid rgba(255,255,255,.08); color: #94a3b8; font-size: 11px; font-family: ui-monospace, monospace; padding: 5px 10px; border-radius: 8px; display: inline-block; margin: 3px 2px; transition: all .3s; }
    .glass-box:hover .field-log-badge { border-color: rgba(99,102,241,.4); color: #c7d2fe; }
    .field-log-badge:hover { background: rgba(99,102,241,.25); color: #fff; transform: translateY(-2px); }

    /* ---------- Marquee ---------- */
    .marquee { overflow: hidden; mask-image: linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent); -webkit-mask-image: linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent); }
    .marquee-track { display: flex; gap: 16px; width: max-content; animation: marquee 32s linear infinite; }
    .marquee:hover .marquee-track { animation-play-state: paused; }
    @keyframes marquee { to { transform: translateX(-50%); } }
    .tech-pill { display: inline-flex; align-items: center; gap: 9px; padding: 11px 22px; border-radius: 999px; background: rgba(255,255,255,.04); border: 1px solid var(--glass-border); color: #cbd5e1; font-size: 14px; font-weight: 500; transition: all .3s; }
    .tech-pill:hover { background: rgba(99,102,241,.2); border-color: rgba(99,102,241,.6); color: #fff; transform: scale(1.06); box-shadow: 0 0 20px rgba(99,102,241,.3); }

    /* ---------- Role Tabs Dashboard Preview ---------- */
    .role-pills .nav-link { color: #94a3b8; border-radius: 14px; padding: 12px 24px; font-weight: 600; transition: all .35s; border: 1px solid transparent; }
    .role-pills .nav-link:hover { color: #fff; background: rgba(255,255,255,.05); }
    .role-pills .nav-link.active { color: #fff; background: linear-gradient(135deg, var(--indigo-primary), var(--purple-accent)); box-shadow: 0 10px 28px rgba(99,102,241,.45); }
    .role-list li { margin-bottom: 14px; display: flex; gap: 12px; align-items: flex-start; color: #cbd5e1; font-size: 15px; }
    .role-list i { color: var(--cyan-accent); margin-top: 3px; font-size: 16px; }
    
    .mock-dash { background: linear-gradient(145deg, rgba(15,23,42,.92), rgba(3,7,18,.95)); border: 1px solid var(--glass-border); border-radius: 20px; padding: 22px; box-shadow: 0 20px 40px rgba(0,0,0,.5); }
    .bar-row { display: flex; align-items: flex-end; gap: 10px; height: 125px; }
    .bar-row span { flex: 1; border-radius: 10px 10px 4px 4px; background: linear-gradient(180deg, var(--cyan-accent), var(--indigo-primary)); transform-origin: bottom; animation: growBar 1.5s cubic-bezier(.16,1,.3,1) both; opacity: .9; }
    .bar-row span:hover { filter: brightness(1.35); box-shadow: 0 0 15px var(--cyan-accent); }
    @keyframes growBar { from { transform: scaleY(0); } }

    /* ---------- Testimonial Carousel ---------- */
    #testiCarousel .carousel-item { padding: 10px 6px 55px; }
    .testi-card { padding: 40px; border-radius: 28px; background: linear-gradient(145deg, rgba(99,102,241,.16), rgba(6,182,212,.08) 60%, rgba(236,72,153,.12)); border: 1px solid var(--glass-border); backdrop-filter: blur(22px); text-align: center; box-shadow: 0 20px 45px rgba(0,0,0,.4); }
    .avatar-grad { width: 72px; height: 72px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 28px; font-weight: 700; color: #fff; background: linear-gradient(135deg, var(--cyan-accent), var(--purple-accent), var(--pink-accent)); box-shadow: 0 0 30px rgba(99,102,241,.6); margin-bottom: 18px; }
    #testiCarousel .carousel-indicators { bottom: 0; }
    #testiCarousel .carousel-indicators [data-bs-target] { width: 32px; height: 4px; border-radius: 4px; border: 0; background: linear-gradient(90deg, var(--cyan-accent), var(--indigo-primary)); }
    #testiCarousel .carousel-control-prev, #testiCarousel .carousel-control-next { width: 55px; opacity: .65; }
    #testiCarousel .carousel-control-prev:hover, #testiCarousel .carousel-control-next:hover { opacity: 1; }

    /* ---------- Timeline Flow ---------- */
    .timeline { position: relative; padding-left: 38px; }
    .timeline::before { content:""; position:absolute; left: 13px; top: 8px; bottom: 8px; width: 2.5px; background: linear-gradient(180deg, var(--cyan-accent), var(--indigo-primary), var(--pink-accent)); opacity: .6; }
    .tl-item { position: relative; margin-bottom: 30px; padding: 20px 24px; border-radius: 20px; background: rgba(255,255,255,.03); border: 1px solid var(--glass-border); transition: all .4s; }
    .tl-item:hover { transform: translateX(8px); border-color: rgba(99,102,241,.5); background: rgba(99,102,241,.1); box-shadow: 0 10px 30px rgba(0,0,0,.4); }
    .tl-item::before { content:""; position:absolute; left:-35px; top: 24px; width: 16px; height: 16px; border-radius: 50%; background: var(--bg-dark); border: 3.5px solid var(--cyan-accent); box-shadow: 0 0 16px var(--cyan-accent); }

    /* ---------- FAQ Accordion ---------- */
    .accordion-item { background: rgba(255,255,255,.03) !important; border: 1px solid var(--glass-border) !important; border-radius: 18px !important; margin-bottom: 14px; overflow: hidden; transition: border-color .3s; }
    .accordion-item:hover { border-color: rgba(99,102,241,.45) !important; }
    .accordion-button { background: transparent !important; color: #f1f5f9 !important; font-weight: 600; box-shadow: none !important; padding: 18px 22px; }
    .accordion-button:not(.collapsed) { color: var(--cyan-accent) !important; background: rgba(6,182,212,.05) !important; }

    /* ---------- Form Inputs & Buttons ---------- */
    .form-control, .input-group-text { transition: all .3s; }
    .form-control:focus { border-color: var(--indigo-primary) !important; box-shadow: 0 0 0 4px rgba(99,102,241,.2) !important; background: rgba(3,7,18,.9) !important; color: #fff !important; }
    .input-group:focus-within .input-group-text { color: var(--cyan-accent) !important; border-color: var(--indigo-primary) !important; background: rgba(99,102,241,.1) !important; }

    /* ---------- Cyber Boot Overlay Loader ---------- */
    .ai-boot-overlay { position: fixed; inset: 0; background: #010409; z-index: 9999; display: none; align-items: center; justify-content: center; font-family: ui-monospace, monospace; padding: 16px; }
